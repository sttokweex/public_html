                sendTelemetryToServer();
                controlHandler.postDelayed(this, HEARTBEAT_INTERVAL);
            }
        };
        controlHandler.post(controlTask);
    }
    
    private void processControl() {
        // Стабилизация по данным сенсоров
        if (rtlActive) {
            executeRTL();
        } else if (emergencyLanding) {
            executeEmergencyLanding();
        } else {
            // Нормальное управление с стабилизацией
            stabilizeFlight();
        }
    }
    
    private void stabilizeFlight() {
        // Целевые углы (от веб-интерфейса или автопилота)
        float targetRoll = controlData.targetRoll;
        float targetPitch = controlData.targetPitch;
        float targetYaw = controlData.targetYaw;
        
        // Текущие углы из датчиков
        float currentRoll = sensorData.roll;

sttokweex, [09.10.2025 16:00]
float currentPitch = sensorData.pitch;
        float currentYaw = sensorData.yaw;
        
        // ПИД регулирование
        float rollCorrection = (float) rollPID.calculate(targetRoll, currentRoll);
        float pitchCorrection = (float) pitchPID.calculate(targetPitch, currentPitch);
        float yawCorrection = (float) yawPID.calculate(targetYaw, currentYaw);
        
        // Применение корректировок
        controlData.roll = (int) (90 + rollCorrection * 45); // ±45 градусов
        controlData.pitch = (int) (90 + pitchCorrection * 45);
        controlData.yaw = (int) (90 + yawCorrection * 45);
        
        // Ограничения
        controlData.roll = constrain(controlData.roll, 0, 180);
        controlData.pitch = constrain(controlData.pitch, 0, 180);
        controlData.yaw = constrain(controlData.yaw, 0, 180);
    }
    
    private void executeRTL() {
        // Возврат к точке взлета используя GPS
        if (gpsData.homeLat == 0 || gpsData.homeLon == 0) {
            // Сохраняем текущую позицию как домашнюю
            gpsData.homeLat = gpsData.latitude;
            gpsData.homeLon = gpsData.longitude;
        }
        
        // Навигация к домашней точке
        double distance = calculateDistance(gpsData.latitude, gpsData.longitude, 
                                          gpsData.homeLat, gpsData.homeLon);
        double bearing = calculateBearing(gpsData.latitude, gpsData.longitude,
                                        gpsData.homeLat, gpsData.homeLon);
        
        if (distance > 10) { // 10 метров
            // Наведение на домашнюю точку
            float targetYaw = (float) bearing;
            controlData.yaw = (int) (90 + (targetYaw - sensorData.yaw) * 0.1);
            
            // Регулировка высоты и скорости
            controlData.throttle = 1300;
            controlData.pitch = 95; // Легкий наклон вперед
        } else {
            // Прибыли - посадка
            controlData.throttle = 1100;
            rtlActive = false;
            sendToServer("RTL_COMPLETED");
        }
    }
    
    private void executeEmergencyLanding() {
        // Плавное снижение
        if (controlData.throttle > 1100) {
            controlData.throttle -= 2;
        } else {
            emergencyLanding = false;
            sendToServer("EMERGENCY_LANDING_COMPLETE");
        }
    }
    
    private void sendControlToArduino() {
        if (usbSerial != null && usbSerial.isConnected()) {
            String command = String.format("THR:%d;ROL:%d;PIT:%d;YAW:%d;GR:%d",
                controlData.throttle, controlData.roll, controlData.pitch, 
                controlData.yaw, controlData.gear);
            
            usbSerial.write(command + "\n");
        }
    }
    
    private void sendTelemetryToServer() {
        if (webSocket != null && webSocket.isOpen()) {
            String telemetry = String.format(
                "TELEMETRY:THR:%d;LAT:%.6f;LON:%.6f;ALT:%.1f;ROL:%.1f;PIT:%.1f;YAW:%.1f;SPD:%.1f;BAT:%d",
