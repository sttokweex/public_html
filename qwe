    private void checkGpsSafety() {
        // Проверка потери GPS сигнала
        if (gpsData.accuracy > 50.0) { // Неточность более 50 метров
            handleGpsSignalLost();
        }
        
        // Проверка гео-зоны
        if (isOutOfGeofence()) {
            handleGeofenceViolation();
        }
    }
    
    private void handleConnectionLost() {
