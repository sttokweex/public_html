                gpsData.altitude, sensorData.roll, sensorData.pitch, sensorData.yaw,
                gpsData.speed, getBatteryLevel()
            );
            
            webSocket.send(telemetry);
            lastServerHeartbeat = System.currentTimeMillis();
        }
    }
    
