sensorData.gyroY = event.values[1];
                sensorData.gyroZ = event.values[2];
                break;
                
            case Sensor.TYPE_MAGNETIC_FIELD:
                sensorData.magX = event.values[0];
                sensorData.magY = event.values[1];
                sensorData.magZ = event.values[2];
                break;
                
            case Sensor.TYPE_ROTATION_VECTOR:
                float[] rotationMatrix = new float[9];
                float[] orientation = new float[3];
                
                SensorManager.getRotationMatrixFromVector(rotationMatrix, event.values);
                SensorManager.getOrientation(rotationMatrix, orientation);
                
                // Конвертация радиан в градусы
                sensorData.yaw = (float) Math.toDegrees(orientation[0]);
                sensorData.pitch = (float) Math.toDegrees(orientation[1]);
                sensorData.roll = (float) Math.toDegrees(orientation[2]);
                
                updateOrientationDisplay();
                break;
        }
    }
    
    @Override
